{
  "name": "@nicolabz/design-system",
  "version": "0.4.0",
  "private": true,
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/theme.js",
    "./src/components.js"
  ],
  "exports": {
    "./theme.css": "./src/styles/theme.css",
    "./components.css": "./src/styles/components.css",
    "./typography.css": "./src/styles/typography.css",
    "./decorations.css": "./src/styles/decorations.css",
    "./icons.css": "./src/styles/icons.css",
    "./icons.svg": "./src/icons/icons.svg",
    "./components.js": "./src/components.js",
    "./theme.js": "./src/theme.js"
  },
  "scripts": {
    "build": "node scripts/build-tokens.js && node scripts/build-icons.js",
    "build:icons": "node scripts/build-icons.js",
    "check": "node scripts/build-tokens.js --check && node scripts/build-icons.js --check",
    "test": "node --test",
    "demo": "http-server . -p 5500 -o /demo/index.html -c-1"
  },
  "devDependencies": {
    "lucide-static": "^1.72.0",
    "http-server": "^14.1.1"
  }
}
