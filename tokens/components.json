
{
  "version": "0.2.0",
  "source": "src/styles/components.css",
  "components": [
    {
      "name": "Button",
      "description": "Interactive element for user actions.",
      "selector": ".button",
      "variants": {
        "primary": ".button-primary",
        "secondary": ".button-secondary"
      },
      "states": ["hover", "focus-visible"],
      "usage": "Combine .button with a variant class."
    },
    {
      "name": "Panel",
      "description": "Container for grouping related content.",
      "selector": ".panel",
      "variants": {
        "muted": ".panel-muted"
      },
      "states": []
    },
    {
      "name": "Badge",
      "description": "Compact status or information indicator.",
      "selector": ".badge",
      "variants": {
        "success": ".badge-success"
      },
      "states": [],
      "usage": "Combine .badge with .badge-success for success states."
    },
    {
      "name": "Tag",
      "description": "Small label for categorizing content.",
      "selector": ".tag",
      "variants": {},
      "states": []
    },
    {
      "name": "Form Panel",
      "description": "Scoped form styling for labels, inputs, and selects.",
      "selector": ".form-panel",
      "elements": {
        "label": ".form-panel label",
        "input": ".form-panel input",
        "select": ".form-panel select",
        "textarea": ".form-panel textarea",
        "button": ".form-panel button"
      },
      "states": ["focus", "focus-visible"],
      "variants": {},
      "usage": "Apply .form-panel to a parent container."
    },
    {
      "name": "Navigation List",
      "description": "Vertical list of links with hover and current-page styling.",
      "selector": ".nav-list",
      "elements": {
        "link": ".nav-list a"
      },
      "states": ["hover", "focus-visible", "current"],
      "variants": {},
      "usage": "Use semantic navigation markup and aria-current=\"page\" for the current page."
    }
  ]
}
